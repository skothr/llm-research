theory/series/dist/

# OS / editor
.DS_Store
*.swp
.idea
.idea/
.vscode
.vscode/

# Shell / tooling dotfiles that the sandbox materializes at the repo root as
# /dev/null bind mounts. They are character devices, not directories, so the
# trailing-slash patterns above do not match them — hence the bare forms too.
# Public repo: none of these should ever be committed by a `git add -A`.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.mcp.json
.ripgreprc
# .gitmodules is masked the same way, and leaving it untracked is not an
# option: `git add -A` aborts with "can only add regular files, symbolic
# links or git-directories" rather than skipping it. IF THIS REPO EVER GAINS
# A REAL SUBMODULE, DELETE THE NEXT LINE — .gitmodules must be tracked for
# submodules to work.
.gitmodules

# Claude Code worktrees / scratch (also keeps concurrent sessions out of git)
.claude/
debug-images/


# Arc data cache dirs: regenerable heavy artifacts (full lens tensors, fit
# checkpoints, derived scans) live in data/cache/ and stay out of git; the
# committed deliverables are the top-level data/ files + MANIFEST.json.
research/arcs/*/data/cache/

# Arc-04 exception (owner decision 2026-08-16, follow-up to PR #38): the
# three lenses refit in the C4-redaction re-run are committed via LFS so
# a clean clone can re-scan without the ~23 h refit. Default-deny inside
# cache/ with explicit whitelists, so the byte-identical working mirrors
# of data/ artifacts that also live there can never be swept up by a
# bulk git add. The PAUSE flag is covered by the default-deny; fit-resume
# .ckpt.pt checkpoints are NOT (the jlens_*.pt whitelist re-includes
# them) — they stay local only via the explicit re-deny below the
# whitelists, so keep that line. The jlens_* whitelists deliberately
# also cover the two 1.5B nf4 lenses scheduled in issue #47.
!research/arcs/04_jspace/data/cache/
research/arcs/04_jspace/data/cache/*
!research/arcs/04_jspace/data/cache/jlens_*.pt
!research/arcs/04_jspace/data/cache/jlens_*.config.json
!research/arcs/04_jspace/data/cache/jlens_*.segments.json
!research/arcs/04_jspace/data/cache/*.log
!research/arcs/04_jspace/data/cache/logs/
research/arcs/04_jspace/data/cache/logs/*
!research/arcs/04_jspace/data/cache/logs/*.log
research/arcs/04_jspace/data/cache/jlens_*.ckpt.pt
research/arcs/04_jspace/data/cache/jlens_*layer-subset*
