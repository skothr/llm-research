{
  // Every path here is relative, so a clean clone of this public repo
  // type-checks with no machine-specific edits. Shared rule settings live in
  // ./pyright-base.json (vendored in-repo for the same reason).
  //
  // Environment: create the venv this repo documents in CLAUDE.md —
  //   python3 -m venv .venv
  //   .venv/bin/pip install -e ../jacobian-lens  # jlens — jspace_* scripts
  //   .venv/bin/pip install -e '.[dev]'          # torch/numpy/mpl + pytest
  // Without a resolvable .venv, pyright falls back to the ambient interpreter
  // and emits wrong-environment noise (e.g. an old torch that does not export
  // `randn_like`). A git worktree, if used, is its own checkout and needs its own entry,
  // most cheaply as a link back to the main one:
  //   ln -s ../../../.venv .venv     # run inside .claude/worktrees/<name>/
  "extends": "./pyright-base.json",
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    ".venv",
    ".cache",
    "**/__pycache__"
  ],
  // The sibling checkout `../jacobian-lens` is pip-installed editable, but
  // setuptools' editable wheels use an import-hook finder that pyright cannot
  // follow, so its source root is listed explicitly.
  // The `../../../../` entry covers the same sibling as seen from a git
  // worktree, which Claude Code's EnterWorktree places at
  // <repo>/.claude/worktrees/<name>/ — four levels below the sibling's parent.
  // Paths that do not exist in a given checkout are simply unused.
  "extraPaths": [
    "examples",
    "../jacobian-lens",
    "../../../../jacobian-lens"
  ]
}
